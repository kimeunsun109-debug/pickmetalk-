# Copy to .env.local and fill in values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional override (default: deepseek-v4-flash). Legacy deepseek-chat retired 2026-07-24.
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: Tavily web search (weather, stocks, etc.)
TAVILY_API_KEY=

# Canonical origin for OAuth / email redirects (prod: https://pickmetalk.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Social login (Google / Kakao) ---
# Enable providers in Supabase Dashboard → Authentication → Providers.
# Put Google/Kakao Client ID + Client Secret ONLY in the Dashboard
# (never as NEXT_PUBLIC_*). See docs/AUTH_OAUTH.md for redirect URI checklist.
# Required Dashboard redirect allow list includes:
#   http://localhost:3000/api/auth/callback
#   https://pickmetalk.com/api/auth/callback

# Photo push cron (Vercel Cron → /api/cron/photo-push)
CRON_SECRET=

# Photo Storage bridge (ops uploads; product reads)
PHOTO_STORAGE_BUCKET=character-photos
# PHOTO_CDN_BASE_URL=https://cdn.example.com

# Web Push (optional — leave unset to mock)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@pickmetalk.com

# Optional: set to "true" to enable PWA in next.config
# ENABLE_PWA=false

# Optional: set to "false" to disable Tavily web search
# ENABLE_WEB_SEARCH=true
