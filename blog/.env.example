# Naver blog credentials — copy to .env and fill in (never commit .env)
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password
BLOG_ID=your_blog_id

# draft = 임시저장 (권장) | publish = 발행
BLOG_POST_MODE=draft

# true = Headless Chrome (백그라운드)
HEADLESS=true

# Chrome 로그인 세션 저장 폴더 (최초 1회 HEADLESS=false 로 수동 로그인 권장)
CHROME_USER_DATA_DIR=%LOCALAPPDATA%\naver-blog-selenium-profile

# 블로그 이미지: pollinations(기본,무료AI) | pexels | openai
BLOG_IMAGE_PROVIDER=pollinations
# PEXELS_API_KEY=
# OPENAI_API_KEY=

# 매일 07:00 (selenium_blog_scheduler.py 사용 시)
SCHEDULE_TIME=07:00
