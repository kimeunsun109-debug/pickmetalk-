+// ─── Memory summary persistence ──────────────────────────────
+
+test("memory_summary에 personal 저장됨", () => {
+  const summary = updateMemorySummary(null, "망고라는 강아지가 있어");
+  expect(summary).notToBeNull();
+  expect(summary!).toContain("[personal]");
+  expect(summary!).toContain("망고");
+});
